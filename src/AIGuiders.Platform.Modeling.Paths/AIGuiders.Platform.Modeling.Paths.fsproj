<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AIGuiders.Platform.Modeling.Paths</RootNamespace>
    <AssemblyName>AIGuiders.Platform.Modeling.Paths</AssemblyName>
    <Description>Logical repo paths and physical path boundary (GUIDERS-ADR-0050).</Description>
    <PackageId>AIGuiders.Platform.Modeling.Paths</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <!-- TruePath = implementation detail (ADR-0050): публичная поверхность Modeling.Paths —
         LogicalPath/PathBoundary (string + LogicalPath), TruePath-типы наружу не экспонируются.
         Зависимость рантаймная — НЕ PrivateAssets (иначе у потребителя MissingAssembly);
         граница держится культурой: `open TruePath` только внутри Modeling.Paths. -->
    <PackageReference Include="TruePath" />
    <PackageReference Include="TruePath.SystemIo" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="LogicalPath.fs" />
    <Compile Include="PathBoundary.fs" />
  </ItemGroup>
</Project>
