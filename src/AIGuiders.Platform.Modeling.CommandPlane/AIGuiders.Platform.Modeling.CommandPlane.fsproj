<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AIGuiders.Platform.Modeling.CommandPlane</RootNamespace>
    <AssemblyName>AIGuiders.Platform.Modeling.CommandPlane</AssemblyName>
    <Description>CommandPlane M-shapes — prefix-arm match algebra, constructor definitions, locale date parse (F# SSOT, ADR-0003 §4.6, GUIDERS-ADR-0037/0038).</Description>
    <PackageId>AIGuiders.Platform.Modeling.CommandPlane</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PrefixArmShapes.fs" />
    <Compile Include="ConstructorShapes.fs" />
    <Compile Include="LocaleDateAlgebra.fs" />
  </ItemGroup>
</Project>