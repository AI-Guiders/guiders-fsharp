<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AIGuiders.Platform.Modeling.Gdl.Parse.Catalog</RootNamespace>
    <AssemblyName>AIGuiders.Platform.Modeling.Gdl.Parse.Catalog</AssemblyName>
    <Description>GDL catalog quarry parser — F# mirror of Platform Authoring.Command.Catalog (phase 1: structure + spine mapping). Parity gaps vs C# authoring emit path: profile bundle resolution (ICatalogBundleLibrary / CatalogProfileResolver), command-profile cross-validation, import-alias bundle path resolution, full notation grammar wire validation (C# injects keyboard parsers), CatalogPhraseSlotIndex codegen inputs.</Description>
    <PackageId>AIGuiders.Platform.Modeling.Gdl.Parse.Catalog</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="CatalogGrammarValidator.fs" />
    <Compile Include="CatalogParser.fs" />
    <Compile Include="CatalogMapping.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Gdl.Authoring\AIGuiders.Platform.Modeling.Gdl.Authoring.fsproj" />
    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Gdl.Command\AIGuiders.Platform.Modeling.Gdl.Command.fsproj" />
    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Gdl.Core\AIGuiders.Platform.Modeling.Gdl.Core.fsproj" />
  </ItemGroup>
</Project>
