    <RootNamespace>AIGuiders.Platform.Modeling.Cockpit.Rules</RootNamespace>
    <AssemblyName>AIGuiders.Platform.Modeling.Cockpit.Rules</AssemblyName>
    <Description>Headless cockpit rule evaluation — traceable rule id + matched when.</Description>
