<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>AIGuiders.Platform.Modeling.Language.Adapters.Fcs</RootNamespace>

    <AssemblyName>AIGuiders.Platform.Modeling.Language.Adapters.Fcs</AssemblyName>

    <Description>F# Compiler Service backend for Language Resolver Center.</Description>

    <PackageId>AIGuiders.Platform.Modeling.Language.Adapters.Fcs</PackageId>

  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="FSharp.Compiler.Service" />
    <PackageReference Include="Ionide.ProjInfo" />
    <PackageReference Include="Ionide.ProjInfo.FCS" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" PrivateAssets="all" />

  </ItemGroup>

  <ItemGroup>

    <Compile Include="IFcsProjectOptionsSource.fs" />
    <Compile Include="FcsProjectOptionsGuards.fs" />
    <Compile Include="FcsProjectResolver.fs" />
    <Compile Include="FcsProjInfoProjectOptionsSource.fs" />
    <Compile Include="FcsProbeProjectOptionsSource.fs" />
    <Compile Include="FcsCompilerServicesHost.fs" />
    <Compile Include="FcsWorkspaceMaterializedOptionsSource.fs" />
    <Compile Include="FcsProjectOptionsPipeline.fs" />
    <Compile Include="FcsSessionPatchBridge.fs" />
    <Compile Include="FcsLanguageBackend.fs" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\..\..\guiders-core\src\DotNetWorkspace.Core\DotNetWorkspace.Core.csproj" />

    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Language\AIGuiders.Platform.Modeling.Language.fsproj" />

    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Ide.Session\AIGuiders.Platform.Modeling.Ide.Session.fsproj" />

    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Ide.Session.Ports.DotNet\AIGuiders.Platform.Modeling.Ide.Session.Ports.DotNet.fsproj" />

    <ProjectReference Include="..\..\..\guiders-platform\src\AIGuiders.Platform.Execution.Language\AIGuiders.Platform.Execution.Language.csproj" />

  </ItemGroup>

</Project>
