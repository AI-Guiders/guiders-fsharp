<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AIGuiders.Platform.Modeling.Documentation.Correspondence</RootNamespace>
    <AssemblyName>AIGuiders.Platform.Modeling.Documentation.Correspondence</AssemblyName>
    <Description>Documentation correspondence wire shapes — CRS model, forward/reverse map shapes (F# SSOT).</Description>
    <PackageId>AIGuiders.Platform.Modeling.Documentation.Correspondence</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Paths\AIGuiders.Platform.Modeling.Paths.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Correspondence.fs" />
    <Compile Include="CorrespondenceRelationKind.fs" />
    <Compile Include="AdrFacts.fs" />
    <Compile Include="HoareCatalog.fs" />
  </ItemGroup>
</Project>
