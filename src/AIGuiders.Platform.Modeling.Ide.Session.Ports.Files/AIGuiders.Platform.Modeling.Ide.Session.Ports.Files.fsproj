<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AIGuiders.Platform.Modeling.Ide.Session.Ports.Files</RootNamespace>
    <AssemblyName>AIGuiders.Platform.Modeling.Ide.Session.Ports.Files</AssemblyName>
    <Description>md/json/toml/yaml document tree → SolutionGraph port (file-graph provider).</Description>
    <PackageId>AIGuiders.Platform.Modeling.Ide.Session.Ports.Files</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FileGraphProvider.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Ide.Session\AIGuiders.Platform.Modeling.Ide.Session.fsproj" />
  </ItemGroup>
</Project>
