<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AIGuiders.Gdl.Validation</RootNamespace>
    <AssemblyName>AIGuiders.Gdl.Validation</AssemblyName>
    <Description>GDL project validation — cross-ref and quarry rules.</Description>
    <PackageId>AIGuiders.Gdl.Validation</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GdlValidation.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIGuiders.Gdl.Core\AIGuiders.Gdl.Core.fsproj" />
  </ItemGroup>
</Project>
