<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>AIGuiders.Platform.Modeling.Notations.Command</RootNamespace>

    <AssemblyName>AIGuiders.Platform.Modeling.Notations.Command</AssemblyName>

    <Description>Command notation wire and invocation surfaces SSOT (GUIDERS-ADR-0021, ADR-0008).</Description>

    <PackageId>AIGuiders.Platform.Modeling.Notations.Command</PackageId>

  </PropertyGroup>

  <ItemGroup>

    <Compile Include="CommandWire.fs" />

    <Compile Include="SlashNotation.fs" />

    <Compile Include="InvocationModel.fs" />

    <Compile Include="InvocationNotation.fs" />

    <Compile Include="InvocationSurfaceId.fs" />

    <Compile Include="InvocationWireKind.fs" />

    <Compile Include="InvocationSurfaceSpec.fs" />

    <Compile Include="CanonicalInvocation.fs" />

    <Compile Include="InvocationStage.fs" />

    <Compile Include="SurfaceRegistry.fs" />

    <Compile Include="AttachInvocation.fs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIGuiders.Platform.Modeling.Notations.Argument\AIGuiders.Platform.Modeling.Notations.Argument.fsproj" />
  </ItemGroup>

</Project>
