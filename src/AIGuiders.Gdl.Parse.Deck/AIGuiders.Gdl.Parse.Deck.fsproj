<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AIGuiders.Gdl.Parse.Deck</RootNamespace>
    <AssemblyName>AIGuiders.Gdl.Parse.Deck</AssemblyName>
    <Description>GDL deck quarry parser — F# mirror of Platform Authoring.Deck.</Description>
    <PackageId>AIGuiders.Gdl.Parse.Deck</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="DeckParser.fs" />
    <Compile Include="DeckMapping.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIGuiders.Gdl.Authoring\AIGuiders.Gdl.Authoring.fsproj" />
    <ProjectReference Include="..\AIGuiders.Gdl.Presentation\AIGuiders.Gdl.Presentation.fsproj" />
    <ProjectReference Include="..\AIGuiders.Gdl.Core\AIGuiders.Gdl.Core.fsproj" />
  </ItemGroup>
</Project>
