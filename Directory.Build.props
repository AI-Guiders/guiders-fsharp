<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>AI Guiders</Authors>
    <Company>AI Guiders</Company>
    <Product>Guiders Platform Modeling</Product>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/AI-Guiders/guiders-fsharp</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
