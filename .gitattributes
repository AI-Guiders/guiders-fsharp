# Anti-EOL (2026-09-03): normalize text endings to LF in-repo so editor/tool
# rewrites never produce content-free diffs again. Windows shell scripts keep CRLF.
* text=auto

*.fs text eol=lf
*.fsi text eol=lf
*.fsx text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.fsproj text eol=lf
*.slnx text eol=lf
*.sln text eol=crlf
*.props text eol=lf
*.targets text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.docx binary
*.zip binary
*.dll binary
*.exe binary
